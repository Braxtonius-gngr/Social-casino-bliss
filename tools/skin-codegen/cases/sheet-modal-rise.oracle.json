{
  "html": "<div class=\"sm\" data-part=\"root\"><h3 data-part=\"title\">Set tier</h3><p data-part=\"body\">Pick a tier for 3 platforms.</p><button data-part=\"save\">SAVE</button></div>",
  "css": ".sm{position:absolute;left:20px;top:40px;width:320px;height:200px;box-sizing:border-box;padding:24px;background-color:#111014;border:1px solid rgba(255,255,255,.08);border-radius:20px;font-family:system-ui,sans-serif;animation:rise 300ms cubic-bezier(.22,1,.36,1)}\n@keyframes rise{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}\n.sm [data-part=title]{margin:0 0 8px;color:#F8F9FA;font-family:Georgia, \"Times New Roman\", serif;font-size:22px;font-weight:400;letter-spacing:1px;text-transform:uppercase}\n.sm [data-part=body]{margin:0;color:#8A8D93;font-size:14px}\n.sm [data-part=save]{position:absolute;left:24px;top:130px;width:270px;height:44px;border:0;background-image:linear-gradient(180deg,#F3DA92 0%,#D4AF37 48%,#A87A22 100%);color:#050507;border-radius:10px;font-size:13px;font-weight:800}",
  "js": ""
}
