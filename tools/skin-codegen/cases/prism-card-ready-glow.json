{
  "id": "prism-card-ready-glow",
  "tags": [
    "card",
    "app-css",
    "prism",
    "adapted"
  ],
  "source": "app:assets/app.css prism-live-glow (box-shadow pulse restated as a glow layer) + prism-tick",
  "canvas": {
    "width": 380,
    "height": 120,
    "background": "#07070A"
  },
  "tokens": {
