      }
    },
    "parts": [
      {
        "name": "avatar",
        "text": "CC",
        "box": {
          "x": 33,
          "y": 40,
          "width": 40,
          "height": 40
        },
        "styles": {
          "background-color": "rgba(212, 175, 55, 0.15)",
          "color": "{gold}",
          "border-radius": "10px",
          "font-size": "14px",
          "font-weight": "800"
        }
      },
      {
        "name": "name",
        "text": "Crown Coins",
        "styles": {
          "color": "{text}",
          "font-size": "15px",
          "font-weight": "800"
        }
      },
      {
        "name": "tier",
        "text": "S",
        "styles": {
          "color": "{gold}",
          "border": "1px solid {gold}",
          "background-color": "rgba(212, 175, 55, 0.2)",
          "border-radius": "4px",
          "font-size": "11px",
          "font-weight": "900"
        }
      },
      {
        "name": "dot",
        "box": {
          "x": 86,
          "y": 66,
          "width": 8,
          "height": 8
        },
        "styles": {
          "background-color": "{green}",
          "border-radius": "50%"
        }
      },
      {
        "name": "status",
        "text": "READY",
        "styles": {
          "color": "{text}",
          "font-family": "monospace",
          "font-size": "12px",
          "font-weight": "600"
        }
      },
      {
        "name": "glow",
        "box": {
          "x": 20,
          "y": 24,
          "width": 340,
          "height": 72
        },
        "styles": {
          "border-radius": "14px",
          "box-shadow": "rgba(255, 180, 60, 0.95) 3px 0px 0px -1px inset"
        }
      },
      {
        "name": "tick",
        "box": {
          "x": 338,
          "y": 36,
          "width": 8,
          "height": 8
