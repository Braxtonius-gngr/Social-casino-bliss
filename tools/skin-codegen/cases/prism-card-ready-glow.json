      "properties": [
        "opacity"
      ]
    },
    {
      "target": "tick",
      "duration_ms": 2200,
      "delay_ms": 0,
      "iterations": "infinite",
      "direction": "normal",
      "easing": "ease-in-out",
      "properties": [
        "opacity"
