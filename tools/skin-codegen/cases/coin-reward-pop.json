{
  "id": "coin-reward-pop",
  "tags": [
    "reward",
    "app-css",
    "executive",
    "derived"
  ],
  "source": "app:assets/app.css --gold-metal fill, springy press curve, roll-rise",
  "canvas": {
    "width": 240,
    "height": 140,
    "background": "#050507"
  },
  "tokens": {
    "gold": "#D4AF37",
    "text": "#F8F9FA",
    "muted": "#8A8D93",
    "gold-metal": "linear-gradient(180deg, #F3DA92 0%, #D4AF37 48%, #A87A22 100%)"
  },
  "component": {
    "description": "Reward trigger: a gold coin pops in with a springy overshoot, then the \"+1.00 SC\" amount rises 12px into place under it, starting 150ms later.",
    "root": {
      "box": {
        "x": 70,
        "y": 30,
        "width": 100,
        "height": 80
      },
      "styles": {}
    },
    "parts": [
      {
        "name": "coin",
        "box": {
          "x": 100,
          "y": 34,
          "width": 40,
          "height": 40
        },
        "styles": {
          "background-image": "{gold-metal}",
          "border": "2px solid #A87A22",
          "border-radius": "50%"
        }
      },
      {
        "name": "amount",
        "text": "+1.00 SC",
        "styles": {
          "color": "{gold}",
          "font-family": "\"Roboto Mono\", monospace",
          "font-size": "16px",
          "font-weight": "700"
        }
      }
    ]
  },
  "animations": [
    {
      "target": "coin",
      "duration_ms": 420,
      "delay_ms": 0,
      "iterations": 1,
      "direction": "normal",
      "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "properties": [
        "transform",
        "opacity"
      ]
    },
    {
      "target": "amount",
      "duration_ms": 600,
      "delay_ms": 150,
      "iterations": 1,
      "direction": "normal",
      "easing": "ease-out",
      "properties": [
        "transform",
        "opacity"
      ]
    }
  ]
}
