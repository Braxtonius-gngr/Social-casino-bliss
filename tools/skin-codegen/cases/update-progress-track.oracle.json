{
  "html": "<div class=\"tr\" data-part=\"root\"><i data-part=\"fill\"></i></div>",
  "css": ".tr{position:absolute;left:45px;top:29px;width:150px;height:2px;border-radius:2px;background-color:rgba(214,176,98,.18);overflow:hidden}\n.tr [data-part=fill]{position:absolute;inset:0;background-image:linear-gradient(90deg,#B98A33,#F2D894);transform-origin:0 50%;animation:fill 1600ms ease-out both}\n@keyframes fill{from{transform:scaleX(0)}to{transform:scaleX(1)}}",
  "js": ""
}
