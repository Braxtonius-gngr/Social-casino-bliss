{
  "html": "<button class=\"cl\" data-part=\"root\"><span data-part=\"sheen\"></span><span data-part=\"label\">COLLECT</span></button>",
  "css": ".cl{position:absolute;left:30px;top:34px;width:260px;height:52px;box-sizing:border-box;padding:0;display:flex;align-items:center;justify-content:center;background-color:#FFC107;border:3px solid #0B0B0B;box-shadow:4px 4px 0 #0B0B0B;overflow:hidden}\n.cl [data-part=label]{position:relative;color:#0B0B0B;font:900 16px/1 system-ui,sans-serif;letter-spacing:2px}\n.cl [data-part=sheen]{position:absolute;left:0;top:0;width:52px;height:46px;background-image:linear-gradient(115deg,rgba(255,255,255,0) 0%,rgba(255,255,255,.9) 50%,rgba(255,255,255,0) 100%);animation:sweep 1800ms linear infinite}\n@keyframes sweep{from{transform:translateX(-60px)}to{transform:translateX(270px)}}",
  "js": ""
}
