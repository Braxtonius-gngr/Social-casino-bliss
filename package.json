{
  "name": "social-casino-bliss",
  "private": true,
  "description": "Quality-check scripts for this build-free static site. No runtime dependencies - see scripts/.",
  "scripts": {
    "check": "npm run check:syntax && npm run check:refs && npm run check:catalog && npm run check:seo",
    "check:syntax": "node scripts/check-syntax.js",
    "check:refs": "node scripts/check-references.js",
    "check:catalog": "node scripts/validate-catalog.js",
    "check:seo": "node scripts/generate-seo-pages.js --check",
    "test:smoke": "node scripts/smoke-test.js",
    "build:history": "node scripts/catalog-history.js",
    "build:seo": "node scripts/catalog-history.js && node scripts/generate-seo-pages.js",
    "post:weekly": "node scripts/weekly-post.js",
    "setup:push": "node scripts/setup-web-push.js"
  }
}
