# Copy this file to .env and fill in your values (never commit .env)

# Sync with your dailyrollover.com deck (all three, or the runner stays local-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Your account's user id (Supabase dashboard: Authentication > Users)
DRO_OWNER_USER_ID=
# The device_id the runner's collections are logged under. History and streaks
# are keyed on it: change it and the runner's earlier history reads as empty.
DRO_DEVICE_ID=automation-runner

DISCORD_WEBHOOK_URL=
# Comma-separated proxies; empty or this placeholder = your own connection (home IP)
PROXY_POOL=http://res-node-us-tx.provider.net:8080
LIVE_BROWSER=false
USE_SYSTEM_CHROME=true

# Time zone for fixed resets when a platform has no resetTZ (default America/Chicago)
# BOT_TZ=America/Chicago
# Extra pages allowed to read the local HUD feed (comma-separated). The live
# panel (dailyrollover.com, www too) and localhost are always allowed; add a
# Cloudflare preview here only if you open the panel from one.
# HUD_ALLOWED_ORIGINS=https://social-casino-bliss.pages.dev

# --- Discord pull (discord-pull.js: a REST poller, no gateway, no privileged intent) ---
# The bot needs View Channel + Read Message History on the source channel only.
DISCORD_BOT_TOKEN=
DISCORD_PULL_CHANNEL_ID=
DISCORD_PULL_INTERVAL_SEC=60
# Reads to spend on the newest history on the very first run (0 = none)
DISCORD_PULL_BACKFILL=0
# Shared with the ingest-drop and read-drop functions (set the same value in
# the Supabase secrets). Generate a long random one.
INGEST_TOKEN=
# Optional: the uuid drafts are filed for (INGEST_USER_ID works too; defaults to DRO_OWNER_USER_ID).
# Pin it on the function side with the OWNER_USER_ID secret.
# DISCORD_PULL_OWNER_USER_ID=
# Optional: time zone the reader judges "ends tonight" in (default BOT_TZ, else America/Chicago)
# DISCORD_PULL_TZ=America/Chicago
# Optional: false reads bot-authored posts in the source channel too
# DISCORD_PULL_IGNORE_BOTS=true
