{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 300,
            "statusMessage": "Installing dependencies",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "statusMessage": "Syntax check",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/syntax-check.sh"
          }
        ]
      }
    ]
  }
}
